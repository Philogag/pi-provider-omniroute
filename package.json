{
  "name": "@philogag/pi-provider-omniroute",
  "version": "0.0.2",
  "description": "OmniRoute OpenAI-compatible provider for Pi Agent",
  "type": "module",
  "main": "src/index.js",
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "repository": {
    "type": "git",
